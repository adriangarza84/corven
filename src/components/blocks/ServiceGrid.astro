---
import Icon from '../ui/Icon.astro';
import type { NombreIcono } from '../ui/iconos';

interface Props {
  servicios: readonly { icono: NombreIcono; titulo: string; linea: string; href: string }[];
  compacto?: boolean;
}
const { servicios, compacto = false } = Astro.props;
---
<ul class:list={['rejilla', { compacto }]}>
  {servicios.map((s) => (
    <li>
      <a href={s.href} class="tarjeta-servicio">
        <span class="icono"><Icon name={s.icono} size={26} /></span>
        <span class="titulo">{s.titulo}</span>
        <span class="linea">{s.linea}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .rejilla {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 1024px) { .rejilla { gap: 16px; } }

  .tarjeta-servicio {
    display: grid;
    align-content: start;
    gap: 6px;
    height: 100%;
    padding: 18px;
    background: var(--corven-surface);
    border: 1px solid var(--corven-line);
    border-radius: var(--radius-card);
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }
  @media (min-width: 640px) { .tarjeta-servicio { padding: 24px; gap: 8px; } }

  .tarjeta-servicio:hover {
    border-color: #39404A;
    background: var(--corven-surface-2);
  }

  .icono { color: var(--corven-text-dim); margin-bottom: 8px; transition: color 0.18s ease; }
  .tarjeta-servicio:hover .icono { color: var(--corven-accent); }

  .titulo {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--corven-text);
  }
  @media (min-width: 640px) { .titulo { font-size: 18px; } }

  .linea { font-size: 14px; line-height: 1.5; color: var(--corven-text-dim); }
  @media (min-width: 640px) { .linea { font-size: 15px; } }

  .compacto .tarjeta-servicio { padding: 16px; }
</style>
